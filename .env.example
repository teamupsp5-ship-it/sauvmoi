# ── IA (optionnel) ────────────────────────────────────────────────────────────
# Sans clé, le chat utilise les protocoles PSC1 embarqués (mode hors-ligne).
# Sur Railway : Settings → Variables → ajouter ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Serveur ────────────────────────────────────────────────────────────────────
# Railway injecte PORT automatiquement — ne pas le définir manuellement en prod.
PORT=3000

# ── Supabase (requis) ─────────────────────────────────────────────────────────
# Authentification + base de données. Sans ces variables, le serveur ne démarre
# pas (auth, profils, formation, SOS en dépendent). Voir supabase/schema.sql —
# à exécuter dans l'éditeur SQL Supabase AVANT le premier lancement.
# SUPABASE_URL et SUPABASE_ANON_KEY sont aussi renvoyées telles quelles par
# GET /api/config pour le client Supabase navigateur (OAuth Google) — anon est
# conçue pour être publique. SUPABASE_SERVICE_ROLE_KEY reste strictement
# backend, jamais exposée à cette route.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Fiche médicale publique (requis) ──────────────────────────────────────────
# Secret utilisé pour signer (HMAC SHA-256) les URLs de la fiche médicale
# publique encodées dans le QR (/api/public/medical-card/:id.png). Sans
# cette variable, GET /medical-record/qr refuse de générer un nouveau QR et
# /api/public/medical-card/:file refuse de servir quoi que ce soit — échec
# fermé volontaire, jamais de repli silencieux sur un fonctionnement non
# signé. Une chaîne aléatoire longue suffit, ex. openssl rand -hex 32.
MEDICAL_CARD_SECRET=

# ── Centres de santé (requis pour scripts/sync-health-centers.js) ────────────
# Clé API healthsites.io (données OpenStreetMap, licence ODbL) utilisée
# UNIQUEMENT par scripts/sync-health-centers.js (script autonome, jamais
# lu par src/server.js) — sans elle, le script refuse de démarrer. Le
# serveur Express lui-même n'a pas besoin de cette variable : GET
# /api/health-centers lit la table Supabase health_centers, jamais l'API
# healthsites.io directement (voir CLAUDE.md, section Localisation).
HEALTHSITES_API_KEY=

# ── CORS (optionnel) ──────────────────────────────────────────────────────────
# Origines autorisées à appeler l'API depuis un navigateur, séparées par des
# virgules. Sans cette variable, src/server.js utilise une liste par défaut
# couvrant déjà Render, la WebView Capacitor Android, le dev local et
# l'instance o2switch — à définir seulement pour ajouter un domaine
# supplémentaire (ex. un nom de domaine propre) sans redéployer le code.
# CORS_ALLOWED_ORIGINS=https://sauvmoi.onrender.com,https://localhost,http://localhost:3000,https://sc3jdmi5414.universe.wf
